REGISTRY_PATH=registry.json
AUDIT_LOG_PATH=audit_log.json
IDENTITIES_PATH=identities.json
CONTRIBUTIONS_PATH=contributions.json
LOG_FORMAT=pretty
PORT=3000
RUST_LOG=info
# PKARR_SECRET_KEY=<64 hex chars>  # curator identity; registry.json must be signed by this key
# ALLOW_UNSIGNED_REGISTRY=true      # dev only: start even if registry.json / audit_log.json aren't signed by PKARR_SECRET_KEY
